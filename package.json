{
  "name": "@idogee/permissio",
  "version": "0.2.2",
  "description": "GitHub Actions permission minimizer for least privilege GITHUB_TOKEN settings.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/iDogRoag/permissio"
  },
  "bugs": {
    "url": "https://github.com/iDogRoag/permissio/issues"
  },
  "homepage": "https://github.com/iDogRoag/permissio#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "permissio": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --dts --clean --splitting false",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "pack:check": "npm pack --dry-run",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "npm run check"
  },
  "keywords": [
    "github-actions",
    "security",
    "least-privilege",
    "github-token",
    "permissions",
    "ci",
    "cicd",
    "devsecops",
    "workflow",
    "actions",
    "static-analysis",
    "developer-tools"
  ],
  "author": "iDogRoag",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.48.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
